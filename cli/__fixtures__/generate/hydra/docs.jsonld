            "label": "id",
            "range": "xsd:string"
          },
          "title": "id",
          "required": false,
          "readable": true,
          "writeable": true
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Error/title",
            "@type": "rdf:Property",
            "domain": "#Error",
            "label": "title",
            "range": "xsd:string"
          },
          "title": "title",
          "required": false,
          "readable": true,
          "writeable": false,
          "description": "A short, human-readable summary of the problem."
        },
        {
          "@type": "SupportedProperty",
          "property": {
            "@id": "#Error/detail",
            "@type": "rdf:Property",
            "domain": "#Error",
            "label": "detail",
            "range": "xsd:string"
          },
          "title": "detail",
          "required": false,
          "readable": true,
          "writeable": false,
          "description": "A human-readable explanation specific to this occurrence of the problem."
        }
      ],
      "supportedOperation": [
        {
          "@type": [
            "Operation",
            "schema:FindAction"
          ],
          "description": "Retrieves a Error resource.",
          "method": "GET",
          "returns": "Error",
          "title": "getError"
        }
      ],
      "description": "A representation of common errors.",
      "subClassOf": "Error"
    },

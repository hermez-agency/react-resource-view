{
  "name": "react-resource-view",
  "version": "1.2.2",
  "description": "CRUD views for REST APIs — API Platform, Strapi, Supabase: list, read, create, update and delete, in table, card, column, split, calendar or timeline layouts.",
  "keywords": [
    "react",
    "crud",
    "strapi",
    "supabase",
    "postgrest",
    "json-ld",
    "jsonld",
    "hydra",
    "api-platform",
    "admin",
    "data-table",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Hermez",
    "url": "https://hermez.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermez-agency/react-resource-view.git"
  },
  "bugs": {
    "url": "https://github.com/hermez-agency/react-resource-view/issues"
  },
  "homepage": "https://hermez.dev/react-resource-view/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "cli/index.mjs",
    "cli/init.mjs",
    "cli/migrate.mjs",
    "migrations",
    "MIGRATION-1.0.md"
  ],
  "bin": {
    "react-resource-view": "./cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack/index.d.ts",
      "import": "./dist/tanstack/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cli/__fixtures__/playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "changeset": "changeset",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-data-form": "^0.3.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-mini-i18n": "^0.1.0 || ^0.2.0",
    "resource-registry": "^0.1.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coooking-pubsub": "^2.0.1",
    "date-fns": "^4.4.0",
    "jsonld-api-client": "^0.1.0",
    "jsonld-item": "^0.1.0",
    "jsonld-repository": "^0.1.0",
    "lucide-react": "^0.577.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "semver": "^7.8.5",
    "shadcn": "^4.18.0",
    "ssr-safe-storage": "^0.1.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.15.0",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2"
}

{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["node_modules/react-resource-view/dist/index.d.ts"],
  "tsconfig": "tsconfig.typedoc.json",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "skipErrorChecking": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "disableSources": true,
  "entryFileName": "index",
  "out": "dist/client/api"
}
